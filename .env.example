# Application mode: "demo" enables synthetic @quotaledger.demo sign-in; "production" disables demo personas and enforces live secrets.
APP_ENV=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Neon pooled runtime URL and direct unpooled migration URL).
# Leave empty locally to boot the embedded zero-config PGLite database automatically.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=

# Cryptographic secrets (required in APP_ENV=production; minimum 32 characters / 32-byte hex or base64)
SESSION_SECRET=replace-with-at-least-32-random-characters-for-sessions
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional seed safety interlock for explicit CLI seeding against PostgreSQL
ALLOW_PROD_SEED=0

# Recurring Billing - Stripe (optional in demo mode; activates Non-Charging Demo Mode when omitted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=

# Recurring Billing - Razorpay for INR workspaces (optional in demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional OpenAI-compatible LLM adapter for Commission Explanation summaries
# Deterministic citation engine is always primary and authoritative.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OAuth / Integration Client Credentials (never marked connected unless configured & verified)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SLACK_BOT_SIGNING_SECRET=
